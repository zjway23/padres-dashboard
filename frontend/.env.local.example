# Copy to `.env.local` and fill in from the Firebase console:
#   Project settings → General → Your apps → Web app → SDK setup and configuration
#
# `.env.local` is gitignored (see the `*.local` rule); this template is not, so
# keep real values out of it. Vite only exposes vars prefixed with VITE_, and it
# reads them at dev-server start, so restart `npm run dev` after editing.
#
# Google sign-in also needs `localhost` under
#   Firebase console → Authentication → Settings → Authorized domains
# (it is there by default on a new project).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend base URL. Defaults to http://localhost:5001 when unset, which is what
# `python3 app.py` serves, so you only need this if you moved the backend.
# VITE_API_URL=http://localhost:5001
